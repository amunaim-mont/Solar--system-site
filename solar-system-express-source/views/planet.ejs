<%- include('partials/header', { title: planet.name }) %>
<section class="planet-detail"><div class="detail-image" style="--planet-color: <%= planet.color %>"><img src="<%= planet.image %>" alt="<%= planet.name %>"></div><div class="detail-content"><p class="eyebrow"><%= planet.order %> / <%= planet.type %></p><h1><%= planet.name %></h1><p class="lead"><%= planet.description %></p><div class="stat-grid"><div><span>Distance from Sun</span><strong><%= planet.distanceFromSun %></strong></div><div><span>Diameter</span><strong><%= planet.diameter %></strong></div><div><span>Radius</span><strong><%= planet.radius %></strong></div><div><span>Mass</span><strong><%= planet.mass %></strong></div><div><span>Surface gravity</span><strong><%= planet.gravity %></strong></div><div><span>Moons</span><strong><%= planet.moons %></strong></div><div><span>Length of day</span><strong><%= planet.day %></strong></div><div><span>Length of year</span><strong><%= planet.year %></strong></div><div><span>Average temperature</span><strong><%= planet.temperature %></strong></div><div><span>Atmosphere</span><strong><%= planet.atmosphere %></strong></div></div><a class="back-link" href="/planets">← Back to all planets</a></div></section>
<%- include('partials/footer') %>
