<%- include('partials/header', { title: 'NASA / APOD' }) %>
<section class="page-intro nasa-intro"><p class="eyebrow">03 — NASA / ASTRONOMY PICTURE OF THE DAY</p><h1>Today’s view<br><em>of the universe.</em></h1><p>One image, selected by NASA, with a little context for the cosmos around us.</p></section>
<section class="pod"><div class="pod-media"><% if (pod.media_type === 'video') { %><iframe src="<%= pod.url %>" title="NASA Astronomy Picture of the Day" allowfullscreen></iframe><% } else if (pod.url) { %><img src="<%= pod.hdurl || pod.url %>" alt="<%= pod.title %>"><% } else { %><div class="pod-placeholder">NASA / APOD</div><% } %></div><div class="pod-copy"><p class="eyebrow"><%= pod.date || '2026-11-22' %></p><h2><%= pod.title %></h2><p><%= pod.explanation %></p><% if (pod.copyright) { %><p class="credit">Image credit: <%= pod.copyright %></p><% } %><a class="button dark-button" href="https://apod.nasa.gov/apod/astropix.html" target="_blank" rel="noreferrer">Visit NASA APOD <span>↗</span></a></div></section>
<%- include('partials/footer') %>
